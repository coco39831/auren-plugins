{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation"
  ],
  "properties": {
    "operation": {
      "enum": [
        "list",
        "search",
        "append",
        "correct",
        "archive",
        "restore",
        "export"
      ]
    },
    "query": {
      "type": "string",
      "maxLength": 4000
    },
    "text": {
      "type": "string",
      "maxLength": 1000000
    },
    "id": {
      "type": "string",
      "maxLength": 200
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  }
}
