{
  "format_version": 1,
  "id": "auren.official.learning",
  "name": "官方 learning",
  "version": "1.0.0",
  "host_api": 1,
  "description": "可替換的 learning 能力，保留原有資料與操作語意。",
  "author": "Auren",
  "license": "Proprietary",
  "runtime": {
    "kind": "python",
    "entrypoint": "src/main.py",
    "platforms": [
      "windows-x64"
    ],
    "access": "native",
    "transport": "factory"
  },
  "exports": [
    {
      "id": "service",
      "kind": "provider",
      "contract": "auren.learning/1",
      "input_schema": "schemas/input.json",
      "output_schema": "schemas/output.json",
      "facade": false,
      "methods": [
        "active_roaming_runs",
        "begin_roaming",
        "configure_roaming",
        "diagnose_task_knowledge",
        "discover",
        "explore",
        "health",
        "index_roaming_starts",
        "record_exploration",
        "register_task_diagnostic",
        "roaming_config",
        "roaming_run",
        "roaming_start_times",
        "roaming_state",
        "status",
        "submit",
        "task_diagnostic",
        "update_roaming",
        "verify"
      ]
    }
  ],
  "requires": [
    {
      "contract": "auren.kernel.events/1",
      "required": true
    },
    {
      "contract": "auren.kernel.vault/1",
      "required": true
    },
    {
      "contract": "auren.permission/1",
      "required": true
    }
  ],
  "dependencies": [],
  "permissions": [
    {
      "capability": "host.native",
      "resources": [
        "agent-data"
      ],
      "reason": "官方 Service Protocol 建構與既有資料處理；不是隔離程序。"
    }
  ],
  "prompts": [],
  "state": {
    "schema_version": 1,
    "migrations": []
  },
  "documentation": "README.md",
  "tests": "tests/cases.json",
  "pages": [
    {
      "id": "learning",
      "name": "學習紀錄",
      "contract": "auren.learning/1",
      "renderer": "builtin"
    }
  ]
}
