{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Auren 統一插件套件 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "id",
    "name",
    "version",
    "host_api",
    "description",
    "author",
    "license",
    "runtime",
    "exports",
    "requires",
    "dependencies",
    "permissions",
    "prompts",
    "state",
    "documentation",
    "tests"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$",
      "maxLength": 160
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "host_api": {
      "const": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entrypoint",
        "platforms",
        "access"
      ],
      "properties": {
        "kind": {
          "enum": [
            "python",
            "node",
            "native",
            "wasm",
            "declarative",
            "mcp",
            "web"
          ]
        },
        "entrypoint": {
          "$ref": "#/$defs/path"
        },
        "access": {
          "enum": [
            "brokered",
            "native"
          ]
        },
        "transport": {
          "enum": [
            "stdio",
            "factory"
          ]
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "windows-x64",
              "windows-arm64",
              "linux-x64",
              "macos-arm64",
              "portable"
            ]
          }
        }
      }
    },
    "exports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "contract",
          "input_schema",
          "output_schema"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,63}$"
          },
          "methods": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^_?[a-z][a-z0-9_]*$"
            }
          },
          "kind": {
            "enum": [
              "tool",
              "provider",
              "workflow",
              "ui",
              "adapter"
            ]
          },
          "contract": {
            "$ref": "#/$defs/contract"
          },
          "input_schema": {
            "$ref": "#/$defs/path"
          },
          "output_schema": {
            "$ref": "#/$defs/path"
          },
          "facade": {
            "type": "boolean"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "features": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          }
        }
      }
    },
    "requires": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "contract",
          "required"
        ],
        "properties": {
          "contract": {
            "$ref": "#/$defs/contract"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "version": {
            "$ref": "#/$defs/version"
          }
        }
      }
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "capability",
          "resources",
          "reason"
        ],
        "properties": {
          "capability": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]+$"
          },
          "resources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "prompts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "purpose"
        ],
        "properties": {
          "path": {
            "$ref": "#/$defs/path"
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "migrations"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "minimum": 1
        },
        "migrations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to",
              "forward",
              "rollback"
            ],
            "properties": {
              "from": {
                "type": "integer",
                "minimum": 1
              },
              "to": {
                "type": "integer",
                "minimum": 2
              },
              "forward": {
                "$ref": "#/$defs/path"
              },
              "rollback": {
                "$ref": "#/$defs/path"
              }
            }
          }
        }
      }
    },
    "documentation": {
      "$ref": "#/$defs/path"
    },
    "tests": {
      "$ref": "#/$defs/path"
    },
    "workflows": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/path"
      }
    },
    "config_schema": {
      "$ref": "#/$defs/path"
    },
    "ui": {
      "$ref": "#/$defs/path"
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "contract"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,63}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "contract": {
            "$ref": "#/$defs/contract"
          },
          "renderer": {
            "enum": [
              "builtin",
              "plugin"
            ]
          },
          "ui": {
            "$ref": "#/$defs/path"
          }
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructions"
      ],
      "properties": {
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status_contract": {
          "$ref": "#/$defs/contract"
        },
        "blocks_tasks": {
          "type": "boolean"
        }
      }
    }
  },
  "$defs": {
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "contract": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]+/[1-9][0-9]*$"
    }
  }
}
